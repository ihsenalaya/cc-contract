FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime@sha256:417bd75df6365104c283ea4c1651fb3530d9eb5a4c2fafa51943cff2a94e6385
ARG CC_COMMIT
LABEL org.opencontainers.image.title="CC-Contract PyTorch component and inference workload" org.opencontainers.image.source="https://github.com/ihsenalaya/cc-contract" org.opencontainers.image.revision="$CC_COMMIT"
COPY scripts/requirements-torch.txt /requirements-torch.txt
RUN python -m pip install --no-cache-dir --require-hashes --only-binary=:all: -r /requirements-torch.txt && python -m pip check
ENV PYTHONPATH=/app/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 CC_COMMIT=$CC_COMMIT HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HOME=/tmp/huggingface CUBLAS_WORKSPACE_CONFIG=:4096:8 NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
WORKDIR /app
COPY --chown=10001:10001 src/ /app/src/
USER 10001:10001
ENTRYPOINT ["python", "-m", "cc_contract.torch_workload"]
CMD ["local-selftest", "--device", "cpu"]
